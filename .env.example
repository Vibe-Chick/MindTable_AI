# 이 파일을 복사해서 .env로 만들고 실제 값을 채워 넣으세요.
# .env는 .gitignore에 등록되어 있어 커밋되지 않습니다 - 실제 키는 여기(.env.example)에
# 절대 적지 마세요.
#
# 통합(INTEGRATION_REPORT.md) 이후 LLM 호출은 김주환 브랜치의 llm.py 체계
# (LLM_PROVIDER/LLM_*)로 통일됐다. 기존 ANTHROPIC_* 이름도 별칭으로 계속 인식되므로
# 이전 .env를 그대로 써도 된다 - 아래 두 블록 중 하나만 채우면 된다.

# --- 방법 A: 기존 jaebin 스타일 (그대로 둬도 자동 인식됨) -------------------
ANTHROPIC_API_KEY=
ANTHROPIC_BASE_URL=
ANTHROPIC_MODEL=claude-sonnet-5

# --- 방법 B: 김주환 브랜치 스타일 (신규 팀원 권장) --------------------------
LLM_PROVIDER=openai
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=

# --- LLM 호출 공통 옵션 (ai_engine/llm_client.py) --------------------------
# LLM_STRUCTURED: tools(기본, 국민대 게이트웨이에서 유일하게 동작 확인됨) | json_schema | json_object
LLM_STRUCTURED=tools
# LLM_STUB=1: API 없이 스키마에 맞는 가짜 응답(개발용, 캐시에 안 남음)
LLM_STUB=
# LLM_CACHE_ONLY=1: 캐시에 없으면 에러로 중단. 무대 시연 직전 반드시 켤 것
# (서버 실행 중이면 POST /admin/cache-only {"enabled": true}로도 즉시 전환 가능)
LLM_CACHE_ONLY=
# LLM_DEBUG=1: 원시 응답을 stderr에 덤프 (게이트웨이 진단용)
LLM_DEBUG=
# LLM_WORKERS: 배치 호출(프로필 추출 등) 동시성. 기본 4 (신규 키는 429 위험)
LLM_WORKERS=4

# --- 임베딩 (통합 이후 사용 안 함, 참고용으로 남김) -------------------------
# matching.py의 유사도 계산은 이제 고정 태그 공간(TAGS)+interest_weights로 이루어져
# 임베딩 API가 필요 없다(BRANCH_COMPARISON.md 3.3 참고). 그래도 과거 경로가 필요하면:
VOYAGE_API_KEY=
OPENAI_API_KEY=
