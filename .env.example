# 이 파일을 복사해서 .env로 만들고 실제 값을 채워 넣으세요.
# .env는 .gitignore에 등록되어 있어 커밋되지 않습니다 - 실제 키는 여기(.env.example)에
# 절대 적지 마세요.

# --- LLM 호출 (ai_engine/llm_client.py) ---------------------------------
# 순정 Anthropic API 키. ANTHROPIC_BASE_URL을 같이 주면 /v1/messages 스키마를 쓰는
# 호환 게이트웨이도 지원한다.
ANTHROPIC_API_KEY=
ANTHROPIC_BASE_URL=
ANTHROPIC_MODEL=claude-sonnet-5

# 대학/기관 프록시처럼 OpenAI Chat Completions 스키마(/v1/chat/completions)로 Claude를
# 감싸 제공하는 게이트웨이를 쓸 경우. 설정돼 있으면 이 방식이 최우선으로 사용된다.
LLM_BASE_URL=
LLM_API_KEY=

# --- 임베딩 (ai_engine/matching.py의 get_embedding) ----------------------
# 우선순위: VOYAGE_API_KEY -> OPENAI_API_KEY -> 해시 기반 폴백(둘 다 없어도 동작함).
VOYAGE_API_KEY=
OPENAI_API_KEY=
